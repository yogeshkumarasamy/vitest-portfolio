{
  "name": "turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm check:format && pnpm build && pnpm check-types",
    "check-types": "turbo run check-types",
    "check:format": "prettier --config .prettierrc.json --write --cache --ignore-path .prettierignore \"**/*.{js,jsx,mjs,ts,tsx,md,json}\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=18"
  }
}
