{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["CI"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check:format": {
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:browser:headless": {
      "dependsOn": ["^test:browser:headless"],
      "outputs": [],
      "env": ["CI"]
    }
  }
}
